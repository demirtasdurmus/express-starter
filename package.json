{
  "name": "express-starter",
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Express Starter Boilerplate",
  "keywords": [
    "express",
    "typescript",
    "starter",
    "boilerplate"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.mjs",
  "scripts": {
    "dev": "tsdown --watch --on-success \"DISABLE_SHUTDOWN_LISTENERS=1 node --enable-source-maps dist/index.mjs\"",
    "build": "tsdown && node scripts/minify-assets.js",
    "start": "node --enable-source-maps dist/index.mjs",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:int": "jest --config ./jest-int.config.ts",
    "test:int:watch": "jest --config ./jest-int.config.ts --watchAll --verbose",
    "test:coverage": "jest --config ./jest-int.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix . --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "i18n:check": "i18n-check --source en --locales locales",
    "clean": "bash scripts/clean.sh",
    "commit": "commit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@lingual/i18n-check": "^0.9.5",
    "@types/compression": "^1.8.1",
    "@types/connect-timeout": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cssnano": "^7.1.9",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "terser": "^5.51.2",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.2",
    "i18next-fs-backend": "^2.6.8",
    "i18next-http-middleware": "^3.9.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  }
}
